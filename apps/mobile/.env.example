# FitG app environment (architecture.md §2). Copy to .env.local; only EXPO_PUBLIC_* variables reach the app, and
# nothing secret ever goes here (the app holds the Supabase anon key and nothing else).

# Phase 2 runs entirely on the phone. Phase 3 adds `supabase`.
EXPO_PUBLIC_BACKEND=local
# `mock` = no AI calls at all (deterministic planner + fixtures). `server` from Phase 5.
EXPO_PUBLIC_AI_PROVIDER=mock

# Phase 3
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Analytics and crashes: both stay off when empty.
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
EXPO_PUBLIC_SENTRY_DSN=

# Settings → Developer (time travel). On by default for testing; set 0 for store builds.
EXPO_PUBLIC_DEV_TOOLS=1

# Phase 7 (paywall). Until then the plan reveal goes straight to Today.
EXPO_PUBLIC_RC_IOS_KEY=
EXPO_PUBLIC_RC_ANDROID_KEY=
